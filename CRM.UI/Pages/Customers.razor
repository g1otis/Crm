@page "/customers"

@using Services;
@using CRM.Data.Models;

@inject CustomersService CustomersService
@inject NavigationManager NavigationManager

<h3>Customers</h3>

@if (customers == null)
{
    <p><em>@message</em></p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>First Name</th>
                <th>Last Name</th>
                <th>Age</th>
                <th>Edit</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var cust in customers)
            {
                <tr>
                    <td>@cust.FirstName</td>
                    <td>@cust.LastName</td>
                    <td>@cust.Age</td>
                    <td>
                       <button @onclick="() => NavigateToCustomerEditComponent(cust.Id)">
                            <span class="oi oi-document"></span>
                       </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

<div>
    <button class="btn btn-success" @onclick="OnInitializedAsync"><span class="oi oi-reload"></span></button>
</div>

@code {
    private List<Customer> customers;
    private string message = "Loading...";

    private void NavigateToCustomerEditComponent(Guid customerId)
    {
        NavigationManager.NavigateTo($"edit/{customerId}");
    }

    protected override async Task OnInitializedAsync()
    {
        message = "Loading...";
        try
        {
            customers = await CustomersService.GetAllAsync();
        }
        catch (Exception ex)
        {
            message = ex.Message;
        }
    }
}
